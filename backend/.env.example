# ==========================================
# AIFRE Backend Configuration (.env)
# ==========================================

# Application Settings
APP_NAME=AIFRE
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=supersecret-aifre-dev-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# Leave blank to use default SQLite at backend/data/aifre.db
# DATABASE_URL=sqlite+aiosqlite:///backend/data/aifre.db

# LLM Provider Configuration
# Choose: "ollama" (default local), "openai", or "mock" (for offline testing)
LLM_PROVIDER=ollama

# Ollama Settings (when LLM_PROVIDER=ollama)
# 1. Install Ollama: https://ollama.ai
# 2. Pull model: ollama pull qwen3:4b
# 3. Ensure ollama service is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TIMEOUT=300
# OLLAMA_NUM_THREADS=4 # Defaults to system CPU count for optimal 16GB CPU inference

# OpenAI Settings (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Embeddings & Vector DB
CHROMA_COLLECTION=knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local
