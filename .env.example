# ========================================================
# AIFRE (Agentic AI Financial Requirements Engineering)
# Environment Configuration Template
# ========================================================

# Backend Core
APP_NAME=AIFRE
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-super-secret-hex-key-here-change-in-production

# LLM Provider: "ollama" (recommended local) | "openai" | "mock" (offline test)
LLM_PROVIDER=ollama

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TIMEOUT=300

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Frontend Core
NEXT_PUBLIC_API_URL=http://localhost:8000
